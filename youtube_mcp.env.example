# Optional preferences. Copy this file to "youtube_mcp.env" in the project folder and edit it.
# Real environment variables override these values. Never put secrets in this file.
# See docs/SETUP.md#settings for every setting.

# Timezone for schedule_publish times written without an offset (default: this computer's timezone).
#YOUTUBE_MCP_TIMEZONE=Europe/London

# Region for list_categories and category checks (default: US).
#YOUTUBE_MCP_REGION=GB

# Category for uploads that don't specify one (default: 22, People & Blogs). Use list_categories to see IDs.
#YOUTUBE_MCP_DEFAULT_CATEGORY=28

# Seconds the "Allow Public" dialog waits before cancelling (10-300, default 60).
#YOUTUBE_MCP_CONFIRM_TIMEOUT=60
